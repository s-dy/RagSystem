# Docker 部署忽略文件
.git
.gitignore
.idea
.vscode
__pycache__
*.pyc
*.pyo
.pytest_cache
.venv
node_modules
dist
build
*.egg-info
*.egg

# 测试文件
tests/
test_*.py
*_test.py

# 文档（可选，根据需要调整）
docs/
*.md
!README.md

# 日志文件（运行时生成）
logs/*
!logs/.gitkeep

# 上传文件（运行时生成）
uploads/*
!uploads/.gitkeep

# 模型缓存（通过 volume 挂载）
tf_models/*
!tf_models/.gitkeep

# 环境变量文件（包含敏感信息）
.env

# Docker 相关文件（避免递归）
docker-compose*.yml
Dockerfile*
.dockerignore

# OS 文件
.DS_Store
Thumbs.db
